													              <a name="main-content"></a>
															<header id="main-content-header">
									<a name="main-content"></a>
                    <h1 id="page-title" ng-non-bindable="">
                      Trabalho de Conclusão de Curso                    </h1>
                </header>
														
															<!--front panel regions beg-->
								<div id="content-panels" class="at-panel gpanel panel-display content clearfix">
									<div class="region region-content-top"><div class="region-inner clearfix"><div id="block-os-pages-main-content" class="block block-os-pages no-title"  module="os_pages" delta="main_content"><div class="block-inner clearfix">  
  
  <div class="block-content content" ng-non-bindable=""><article id="node-17988" class="node node-page article clearfix" role="article">
  
  
  
  <div class="node-content" ng-non-bindable="">
    <div class="field field-name-body field-type-text-with-summary field-label-hidden view-mode-full"><div class="field-items"><div class="field-item even"><h3 id="sites-page-title-header" style="font-weight: bold; margin: 0px; padding-left: 10px; padding-right: 10px; color: rgb(68, 68, 68); background: rgb(255, 255, 255); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; text-align: justify;" xmlns="http://www.w3.org/1999/xhtml">
	​​​​
</h3>

<p>
	<strong>Resolução de TCC atualizada: </strong><a data-url="https://drive.google.com/file/d/1I2pPG0gLaZ8Pz0opREXVVQwazfm4V1KK/view?usp=share_link" href="https://drive.google.com/file/d/1I2pPG0gLaZ8Pz0opREXVVQwazfm4V1KK/view?usp=share_link" target="_blank" title="">https://drive.google.com/file/d/1I2pPG0gLaZ8Pz0opREXVVQwazfm4V1KK/view?usp=share_link</a>
</p>

<p>
	<a data-url="https://docs.google.com/document/d/1qC6-pF0-_RDYuzuC2QDjSaej7hsNjjVR/edit?usp=share_link&amp;ouid=116770388307327099040&amp;rtpof=true&amp;sd=true" href="https://docs.google.com/document/d/1qC6-pF0-_RDYuzuC2QDjSaej7hsNjjVR/edit?usp=share_link&amp;ouid=116770388307327099040&amp;rtpof=true&amp;sd=true" target="_blank" title="">Anexos editáveis</a> - clicar em <strong>Arquivo, Fazer download, Microsoft Word (.docx)</strong>
</p>

<p>
	<span style="background-color:#ffffff"><span style="overflow:hidden"><span style="min-height:150px"><span style="color:#444444"><span style="font-style:normal"><span style="font-variant-ligatures:normal"><span style="font-variant-caps:normal"><span style="font-weight:400"><span style="letter-spacing:normal"><span style="orphans:2"><span style="text-transform:none"><span style="white-space:normal"><span style="widows:2"><span style="word-spacing:0px"><span style="text-decoration-style:initial"><span style="text-decoration-color:initial"><span style="vertical-align:top"><span style="line-height:normal"><span style="display:block"><span style="font-weight:bold"><span style="display:block"><span style="display:inline"><b style="color:#222222">O que é o TCC?</b></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span>
</p>

<div style="text-align:left">
	<p>
		<span style="background-color:#ffffff"><span style="overflow:hidden"><span style="min-height:150px"><span style="color:#444444"><span style="font-style:normal"><span style="font-variant-ligatures:normal"><span style="font-variant-caps:normal"><span style="font-weight:400"><span style="letter-spacing:normal"><span style="orphans:2"><span style="text-transform:none"><span style="white-space:normal"><span style="widows:2"><span style="word-spacing:0px"><span style="text-decoration-style:initial"><span style="text-decoration-color:initial"><span style="vertical-align:top"><span style="line-height:normal"><span style="display:block"><span style="color:#222222">O TCC é o trabalho de final de curso que deve obrigatoriamente ser desenvolvido por todos os alunos do curso de Engenharia Elétrica sob supervisor de um professor. </span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span>
	</p>

	<p>
		<strong>ATENÇÃO: <font color="#444444"> </font></strong><a data-url="https://drive.google.com/file/d/1QJKRs5rrWTuR4KXLPBqUD1-fsIHda7NS/view?usp=drive_link" href="https://drive.google.com/file/d/1QJKRs5rrWTuR4KXLPBqUD1-fsIHda7NS/view?usp=drive_link" target="_blank" title="">como solicitar a ficha catalográfica no Sisbin</a>.
	</p>

	<p>
		<a data-url="https://docs.google.com/spreadsheets/d/1xeZQ1EliKp7gJWX68sDd3BM7uJUqeUYNDetu59Q7azA/edit#gid=0" href="https://docs.google.com/spreadsheets/d/1xeZQ1EliKp7gJWX68sDd3BM7uJUqeUYNDetu59Q7azA/edit#gid=0" target="_blank" title="">Relação dos trabalhos em desenvolvimento</a>*
	</p>

	<p>
		<a data-url="https://docs.google.com/spreadsheets/d/1xeZQ1EliKp7gJWX68sDd3BM7uJUqeUYNDetu59Q7azA/edit#gid=698710763" href="https://docs.google.com/spreadsheets/d/1xeZQ1EliKp7gJWX68sDd3BM7uJUqeUYNDetu59Q7azA/edit#gid=698710763" target="_blank" title="">Número de orientações por professor</a>*
	</p>

	<p>
		<span style="font-size:11px;">* Planilhas acessíveis apenas a partir do e-mail institucional da UFOP.</span>
	</p>
</div>
</div></div></div>  </div>

  
  
  </article>
</div>
  </div></div></div></div>																																			</div>
								<!--front panel regions end-->
													
											</div>
				</div>

								  <!--sidebar first region beg-->
				  <div class="region region-sidebar-first sidebar"><div class="region-inner clearfix"><div id="block-boxes-os-pages-section-nav" class="block block-boxes block-boxes-os_boxes_sectionnav section-nav no-title"  module="boxes" delta="os_pages_section_nav"><div class="block-inner clearfix">  
  
